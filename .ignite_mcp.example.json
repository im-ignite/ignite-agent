{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "description": "Standard filesystem Model Context Protocol (MCP) tool server"
    },
    "sqlite": {
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "app.db"
      ],
      "description": "Direct SQLite database MCP querying"
    }
  }
}
